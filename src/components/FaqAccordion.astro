---
// src/components/FaqAccordion.astro
const faqs = [
  {
    question: "Why use Astro instead of a traditional page builder?",
    answer: "Astro strips away unused JavaScript by default, shipping pure HTML and CSS to the browser. This eliminates plugin bloat, prevents layout shifts, and consistently delivers 100/100 Core Web Vitals scores."
  },
  {
    question: "Can I still edit text and settings without touching code?",
    answer: "Yes. Global details like phone numbers, email addresses, and page copy are decoupled into clean Markdown and JSON files inside src/content/, making updates straightforward and safe."
  },
  {
    question: "Do these interactive features require third-party npm packages?",
    answer: "No. Everything—from image sliders and FAQ accordions to scroll-triggered buttons—uses native browser APIs, modern CSS scroll-snap, and lightweight inline scripts."
  },
  {
    question: "How long does a typical Astro build take?",
    answer: "A standard 5-page brochure or agency site typically takes 1 to 2 weeks from initial blueprint schema to production deployment and Lighthouse verification."
  }
];
---

<section class="max-w-3xl mx-auto px-4">
  <div class="text-center mb-8">
    <span class="text-violet-400 font-mono text-xs font-bold uppercase tracking-wider">// FAQ</span>
    <h2 class="text-3xl font-extrabold text-white mt-1">Frequently Asked Questions</h2>
  </div>

  <div class="space-y-3">
    {faqs.map((faq) => (
      <details class="group bg-slate-900/60 border border-slate-800 rounded-2xl overflow-hidden transition-colors open:border-violet-500/40 open:bg-slate-900/90">
        <summary class="flex justify-between items-center p-5 sm:p-6 cursor-pointer list-none font-bold text-white text-base select-none hover:text-violet-300 transition">
          <span>{faq.question}</span>
          <span class="ml-4 shrink-0 w-7 h-7 rounded-lg bg-slate-800 group-open:bg-violet-600/20 text-violet-400 flex items-center justify-center transition-transform duration-200 group-open:rotate-180">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </span>
        </summary>
        <div class="px-5 sm:px-6 pb-6 pt-1 text-slate-400 text-sm leading-relaxed border-t border-slate-800/60">
          {faq.answer}
        </div>
      </details>
    ))}
  </div>
</section>