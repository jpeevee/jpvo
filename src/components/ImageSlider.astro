---
// src/components/ImageSlider.astro
const slides = [
  {
    src: "https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=900&q=80",
    tag: "01 // ARCHITECTURE",
    title: "Clean Front-End Engineering",
    caption: "Component-driven Astro layouts with zero runtime overhead."
  },
  {
    src: "https://images.unsplash.com/photo-1507238691740-187a5b1d37b8?auto=format&fit=crop&w=900&q=80",
    tag: "02 // DESIGN SYSTEMS",
    title: "Bespoke Tailwind Interfaces",
    caption: "Consistent dark-mode palettes, fluid typography, and responsive grids."
  },
  {
    src: "https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=900&q=80",
    tag: "03 // PERFORMANCE",
    title: "Instant Static Delivery",
    caption: "Pre-rendered pages optimized for sub-second global load times."
  }
];
---

<section class="px-4">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-6 gap-4">
    <div>
      <span class="text-cyan-400 font-mono text-xs font-bold uppercase tracking-wider">// SHOWCASE</span>
      <h2 class="text-3xl font-extrabold text-white mt-1">Recent Builds & Systems</h2>
    </div>

    <!-- Slider Navigation Buttons -->
    <div class="flex gap-2">
      <button id="slider-prev" aria-label="Previous slide" class="p-2.5 rounded-xl bg-slate-900 border border-slate-800 hover:border-violet-500/50 text-slate-300 hover:text-white transition cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      <button id="slider-next" aria-label="Next slide" class="p-2.5 rounded-xl bg-slate-900 border border-slate-800 hover:border-violet-500/50 text-slate-300 hover:text-white transition cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- CSS Scroll-Snap Track -->
  <div id="slider-track" class="flex gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth no-scrollbar pb-2">
    {slides.map((slide) => (
      <div class="snap-start shrink-0 w-[85%] md:w-[60%] bg-slate-900/70 border border-slate-800 rounded-2xl overflow-hidden shadow-xl group">
        <div class="h-60 sm:h-72 overflow-hidden">
          <img
            src={slide.src}
            alt={slide.title}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          />
        </div>
        <div class="p-6">
          <span class="text-violet-400 font-mono text-xs font-bold">{slide.tag}</span>
          <h3 class="text-xl font-bold text-white mt-1 mb-1.5">{slide.title}</h3>
          <p class="text-slate-400 text-sm">{slide.caption}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  const track = document.getElementById('slider-track');
  const prevBtn = document.getElementById('slider-prev');
  const nextBtn = document.getElementById('slider-next');

  prevBtn?.addEventListener('click', () => {
    track?.scrollBy({ left: -450, behavior: 'smooth' });
  });

  nextBtn?.addEventListener('click', () => {
    track?.scrollBy({ left: 450, behavior: 'smooth' });
  });
</script>